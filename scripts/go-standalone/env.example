### VITALS ###
NODE_PORT=2222
SECRET_KEY=SECRET_KEY_FROM_PANEL

### SING-BOX DATA PLANE (embedded) ###
# Internal gRPC stats endpoint (must match the v2ray_api listen in the generated config)
SINGBOX_STATS_ADDRESS=127.0.0.1:6450
# sing-box log level: debug | info | warn | error
SINGBOX_LOG_LEVEL=warn
# Debounce window (ms) for batching user-change hot-swaps
SINGBOX_DEBOUNCE_MS=5000
# Directory for geosite/geoip rule-set files (.srs) and the download cache
SINGBOX_GEO_DIR=/var/lib/gosingbox/singbox/geo
# Listen address override:
#   leave empty (default) = dual-stack; the panel's 0.0.0.0 is rewritten to ::
#   set SINGBOX_LISTEN=0.0.0.0 to force IPv4-only (kernels with IPv6 disabled)
#   set SINGBOX_LISTEN=::         to force dual-stack explicitly
# SINGBOX_LISTEN=
# geocheck binary path (geo detection); defaults to ./bin/geocheck
# GEOCHECK_BIN_PATH=/usr/local/bin/geocheck
# ASN index (optional): path to asn-prefixes.json (remnawave/asn-index JSON asset)
# ASN_INDEX_PATH=/var/lib/gosingbox/asn-prefixes.json